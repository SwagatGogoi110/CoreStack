ARG VERSION=latest
FROM CloudStack/CloudStack:${VERSION}

LABEL org.opencontainers.image.title="CloudStack (compat)" \
      org.opencontainers.image.description="CloudStack compatibility image with AWS CLI and boto3 pre-installed" \
      org.opencontainers.image.url="https://cloudstack.io" \
      org.opencontainers.image.source="https://github.com/CloudStack-io/CloudStack" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="CloudStack"

ENV AWS_DEFAULT_REGION=us-east-1
ENV AWS_ACCESS_KEY_ID=test
ENV AWS_SECRET_ACCESS_KEY=test
ENV AWS_ENDPOINT_URL="http://localhost:4566"
ENV AWS_CONFIG_FILE=/etc/CloudStack/aws/config

USER root
RUN apk add --no-cache python3 py3-pip \
    && pip3 install --no-cache-dir --break-system-packages awscli boto3

COPY bin/awslocal /usr/local/bin/awslocal
RUN chmod +x /usr/local/bin/awslocal

USER 1001
